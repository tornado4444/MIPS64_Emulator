{
  "version": 3,

  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },

  "configurePresets": [
    {
      "name": "windows-debug",
      "displayName": "Windows Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/windows-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MIPS64_BUILD_CLI": "ON"
      }
    },

    {
      "name": "windows-release",
      "displayName": "Windows Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/windows-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "MIPS64_BUILD_CLI": "ON"
      }
    },

    {
      "name": "linux-debug",
      "displayName": "Linux Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/linux-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MIPS64_BUILD_CLI": "ON"
      }
    },

    {
      "name": "linux-release",
      "displayName": "Linux Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/linux-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "MIPS64_BUILD_CLI": "ON"
      }
    },

    {
      "name": "android-debug",
      "displayName": "Android Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/android-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MIPS64_BUILD_CLI": "OFF"
      }
    }
  ],

  "buildPresets": [
    {
      "name": "windows-debug",
      "configurePreset": "windows-debug"
    },

    {
      "name": "windows-release",
      "configurePreset": "windows-release"
    },

    {
      "name": "linux-debug",
      "configurePreset": "linux-debug"
    },
    
    {
      "name": "linux-release",
      "configurePreset": "linux-release"
    },


    {
      "name": "android-debug",
      "configurePreset": "android-debug"
    }
  ]
}
